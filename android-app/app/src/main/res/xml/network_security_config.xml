<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config for Herpass Android App.
    Allows cleartext HTTP traffic to the local development server.
    10.0.2.2 = Android Emulator host (maps to localhost on your PC).
    Add your physical device server IP below if testing on a real phone.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator → host machine -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Common LAN IPs for physical device testing (adjust to your network) -->
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
